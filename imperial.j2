{#- 2.875 -> "2-7/8": how the source tables write a length. -#}
{%- macro inches(x) -%}
{%- set whole = x | int -%}
{%- set sixteenths = ((x - whole) * 16) | round | int -%}
{%- set fraction = {1: "1/16", 2: "1/8", 3: "3/16", 4: "1/4", 5: "5/16", 6: "3/8", 7: "7/16", 8: "1/2", 9: "9/16", 10: "5/8", 11: "11/16", 12: "3/4", 13: "13/16", 14: "7/8", 15: "15/16"} -%}
{%- if sixteenths == 0 -%}{{ whole }}{%- elif whole == 0 -%}{{ fraction[sixteenths] }}{%- else -%}{{ whole }}-{{ fraction[sixteenths] }}{%- endif -%}
{%- endmacro -%}
